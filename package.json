{
  "name": "design-os-figma-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Thin CLI + Figma plugin relay — an agent and a designer in the same Figma file. Drives a Figma Free plugin (Plugin API) over a local WebSocket broker; never the paid official write MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jangtrinh/design-os-figma-plugin.git"
  },
  "homepage": "https://github.com/jangtrinh/design-os-figma-plugin#readme",
  "bin": {
    "figma-agent": "cli/dist/figma-agent.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:cli": "node scripts/build.mjs cli",
    "build:plugin-main": "node scripts/build.mjs plugin-main",
    "build:plugin-ui": "node scripts/build.mjs plugin-ui",
    "emit:skill": "npm run build:cli --silent && node cli/dist/figma-agent.js __emit-skill > skills/figma-agent/SKILL.md",
    "typecheck": "tsc -p cli --noEmit && tsc -p plugin --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "lint:comments": "node scripts/check-comment-hygiene.mjs",
    "lint:comments:update-baseline": "node scripts/check-comment-hygiene.mjs --update-baseline",
    "lint:comments:self-test": "node scripts/check-comment-hygiene.mjs --self-test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.130.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "ease-design": "0.5.0",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.62.1",
    "thinking-orbs": "0.3.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.3.0"
  }
}
